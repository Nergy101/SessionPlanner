{
  "nodeModulesDir": "manual",
  "tasks": {
    "dev": "vite",
    "build": "vite build",
    "start": "deno task dbup && sh -c 'exec deno serve -A --port ${PORT:-8000} _fresh/server.js'",
    "dbup": "deno run -A db/migrate.ts up",
    "dbdown": "deno run -A db/migrate.ts down",
    "dbredo": "deno run -A db/migrate.ts redo",
    "dbstatus": "deno run -A db/migrate.ts status",
    "test": "deno test -A",
    "check": "deno fmt --check . && deno lint . && deno check",
    "update": "deno run -A -r jsr:@fresh/update .",
    "demo": "DB_PATH=$(mktemp -d)/demo.db sh -c \"deno run -A tests/seed_temp.ts && deno task dev\"",
    "e2e": "deno run -A tests/e2e/run.ts"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "imports": {
    "@/": "./",
    "@kysely/kysely": "jsr:@kysely/kysely@^0.29.5",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@types/node": "npm:@types/node@^26.4.1",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12",
    "@kysely/kysely/migration": "jsr:@kysely/kysely@^0.29.5/migration"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
